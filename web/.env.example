# Tutor voice for the dashboard. Copy this file to `.env` to override the
# default; both files are read by Vite at startup, and a value change needs a
# dev-server restart.

# Browser `SpeechSynthesis` is the demo default and needs no service.
# Set VITE_TTS=voxpocket to use the optional local VoxPocket TTS service
# instead. That service must be running on http://127.0.0.1:8001; see
# docs/DEMO-RUNBOOK.md. Unknown values fall back to the browser voice.
VITE_TTS=browser
