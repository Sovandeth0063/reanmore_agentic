# Local development placeholders only. Copy this file to `.env` and put real
# values there; never commit `.env` and never paste a real key into this file.
#
# The demo uses the HTTPS snapshot API: one worksheet review image, short
# speech turns, and a fresh image per written-work check. There is no room
# transport and no runtime-mode switch.

# Local Ollama for intent fallback and guidance wording. Set OLLAMA_MODEL to
# the model pulled on this laptop; it stays required even when the hosted
# classifier is selected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Intent classification: `opencode` (hosted Haiku) or `ollama` (local).
# Clear commands such as "repeat" or "A2" never call either classifier.
# The same VISION_API_KEY below is reused for intent; there is no second key.
# A hosted failure falls back to OLLAMA_MODEL once.
INTENT_PROVIDER=opencode
INTENT_MODEL=claude-haiku-5-5
INTENT_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Demo: guided flow; template wording (the hosted llm path is opt-in).
# `guided` walks A1 -> B6; `choice` asks the child to pick. `llm` rephrases on
# the INTENT_* route above; `template` is offline and deterministic.
TUTOR_FLOW=guided
TUTOR_RENDERER=template

# Local faster-whisper speech-to-text. CPU int8 is the demo default: the CUDA
# build fails on this laptop without cublas64_12.dll, and the GPU is reserved
# for the VoxPocket voice. There is no automatic GPU retry.
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Vision: `hosted` (default) calls the selected hosted API family; `local` uses
# Ollama and needs no key.
VISION_PROVIDER=hosted
# Hosted vision API family: openai (default) or gemini. Ignored when
# VISION_PROVIDER=local. Gemini is implemented but not selected; it needs a Go
# API key and a phone rehearsal (Task 27) before it could become the default.
VISION_API=openai
# Base URL before the provider path. This is a URL, not a secret.
# OpenCode Console (openai API): https://opencode.ai/inference/openai/v1
# Gemini Go example (commented, not selected):
#   VISION_BASE_URL=https://opencode.ai/inference/go/google/v1beta
#   VISION_MODEL=gemini-4-argon
VISION_BASE_URL=
VISION_MODEL=
# Required only when VISION_PROVIDER=hosted. Left empty here on purpose.
VISION_API_KEY=

LOG_LEVEL=INFO
DB_URL=sqlite:///./data/tutor.db
